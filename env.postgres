# .env.postgres
# Template for hosted deployment (e.g. Render). Copy this to .env on your
# hosting provider (or set these as dashboard environment variables --
# Render does this automatically if you use render.yaml).
#
# DATABASE_URL is what tells db.js to use the Postgres path instead of
# MySQL. Render provides this value automatically when you attach their
# free PostgreSQL database to your web service -- you shouldn't need to
# type it in by hand.

DATABASE_URL=postgresql://user:password@host:5432/dbname
PORT=3000
SESSION_SECRET=change_this_to_a_long_random_string
